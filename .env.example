# ---- 必填 ----
# 从 @BotFather 获取
BOT_TOKEN=
# 超级管理员 user_id，逗号分隔（可向 Bot 发送 /id 查看自己的 ID）
ADMIN_IDS=
# 用于加密数据库中的 API Key，任意足够长的随机字符串，设置后不要更改
SECRET_KEY=

# ---- 首次启动自动创建的 Provider（之后以数据库配置为准）----
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# ---- 可选 ----
# 首次启动时导入的白名单，逗号分隔（之后在 Bot 内用 /allow_user、/allow_group 管理）
ALLOWED_USER_IDS=
# 群组 ID 以 -100 开头，可在群里发送 /id 查看
ALLOWED_CHAT_IDS=
# 代理，同时用于 Telegram 与 AI 请求，支持 http:// 与 socks5://
# Docker 部署时 127.0.0.1 指的是容器自己，代理在宿主机上请写 http://host.docker.internal:端口
PROXY_URL=
# 本地运行时的数据目录（Docker 部署时固定为 /data，此项不生效）
DATA_DIR=./data
LOG_LEVEL=INFO

# ---- 仅 Docker 部署使用 ----
# GitHub Actions 推送的镜像，your-name/tgbot 换成你的 GitHub 用户名/仓库名（小写）
TGBOT_IMAGE=ghcr.io/your-name/tgbot:latest
